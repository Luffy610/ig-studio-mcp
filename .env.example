# Copy to .env and fill in. Never commit .env.
# Step-by-step token guide: docs/TOKEN_SETUP.md

# Required: a token from "API setup with Unified login" -> "Generate access tokens"
# (a Business Integration System User access token, starts with "EAA").
IG_ACCESS_TOKEN=

# Optional: the Instagram account ID to use. Only needed when the token can reach several
# accounts; `uv run ig-studio-mcp check` lists them.
IG_ACCOUNT_ID=

# Optional: your Meta app ID and app secret (App settings -> Basic), not the Instagram app ID.
# Needed only for expiring user tokens (exchange-token / automatic renewal).
# When META_APP_SECRET is set, every API call also sends appsecret_proof.
META_APP_ID=
META_APP_SECRET=
