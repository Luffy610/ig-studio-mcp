# Copy to .env (never commit .env). See README -> "Token setup".

# Required: a Facebook Login access token (starts with "EAA").
# Best: a system-user token from Business settings - it never expires.
# The Instagram account is discovered from the token.
IG_ACCESS_TOKEN=

# Optional: which Instagram account to use, only needed if the token can reach several.
# `uv run ig-studio-mcp check` lists them.
IG_USER_ID=

# Optional: Meta app ID and secret (App settings -> Basic).
# Needed only for user tokens that expire (exchange-token / automatic renewal).
# If IG_APP_SECRET is set, every call also sends appsecret_proof.
IG_APP_ID=
IG_APP_SECRET=
